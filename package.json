{
  "name": "drive-offloader",
  "productName": "Drive Offloader",
  "appId": "net.kbpartner.drive-offloader",
  "version": "0.1.0",
  "description": "AI-powered Windows Storage Cleaner and Google Drive Offloader MVP",
  "author": "KB01111",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KB01111/GG1.git"
  },
  "bugs": {
    "url": "https://github.com/KB01111/GG1/issues"
  },
  "homepage": "https://github.com/KB01111/GG1#readme",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "build": "vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "typecheck:tsgo": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.main.json",
    "lint": "eslint \"src/main/**/*.ts\" \"src/shared/**/*.ts\" \"src/renderer/main.ts\" \"src/renderer/global.d.ts\" \"test/**/*.cjs\"",
    "test": "npm run build && mocha --timeout 30000 --slow 0 \"test/**/*.test.cjs\"",
    "test:unpacked": "npm run package:dir && cross-env TEST_UNPACKED=1 npm test",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs --publish never",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --publish never --dir"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "gaxios": "^7.1.4",
    "googleapis": "^171.4.0",
    "lucide-svelte": "^1.0.1",
    "svelte": "^4.2.20",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "chai": "^4.5.0",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-plugin-svelte": "^3.17.1",
    "mocha": "^10.8.2",
    "playwright-core": "^1.59.1",
    "svelte-eslint-parser": "^1.6.0",
    "svelte-preprocess": "^5.1.4",
    "tree-kill": "^1.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-for-throwable": "^1.0.1"
  }
}
